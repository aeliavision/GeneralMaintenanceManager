<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GeneralMaintenanceManager.App.Views.AssetsView"><Grid Margin="22,16,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Page title -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource EyebrowStyle}" Text="{Binding AssetWorkspaceEyebrow}"/>
                            <Ellipse Margin="6,0,0,0" Width="5" Height="5" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" Text="{Binding AssetWorkspaceTitle}" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,3,0,0" Text="{Binding AssetWorkspaceSubtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Scan-first metrics. Only information already present in the app is shown. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                        <Grid>
                            <Border Width="3" Background="{StaticResource SuccessBrush}" HorizontalAlignment="Left" Margin="-15,-12,0,-12"/>
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource KpiTotalAsset}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding AssetCount, StringFormat={}{0:N0}}" FontSize="26" FontWeight="SemiBold" LineHeight="30"/>
                                <TextBlock Margin="0,3,0,0" Text="{DynamicResource PermanentAssetRecords}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                        <Grid>
                            <Border Width="3" Background="{StaticResource SecondaryBrush}" HorizontalAlignment="Left" Margin="-15,-12,0,-12"/>
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource KpiHistoryItems}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding HistoryCount, StringFormat={}{0:N0}}" FontSize="26" FontWeight="SemiBold" LineHeight="30"/>
                                <TextBlock Margin="0,3,0,0" Text="{DynamicResource ForSelectedView}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                        <Grid>
                            <Border Width="3" Background="{StaticResource ErrorBrush}" HorizontalAlignment="Left" Margin="-15,-12,0,-12"/>
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource KpiMaintenances}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding MaintenanceCount, StringFormat={}{0:N0}}" FontSize="26" FontWeight="SemiBold" LineHeight="30"/>
                                <TextBlock Margin="0,3,0,0" Text="{DynamicResource SelectedMachine}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource KpiCardStyle}">
                        <Grid>
                            <Border Width="3" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Left" Margin="-15,-12,0,-12"/>
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource KpiRecordedMaintenanceCost}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding MaintenanceCost, StringFormat={}{0:N2}}" FontSize="26" FontWeight="SemiBold" LineHeight="30"/>
                                <TextBlock Margin="0,3,0,0" Text="{DynamicResource SelectedMachine}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Asset registry + lifetime history workspace -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Asset list -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="56"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="16,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Asset}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource SelectMachineToOpenRecord}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="7,3" Background="{StaticResource SecondarySoftBrush}" CornerRadius="3">
                                        <TextBlock Text="{Binding AssetCountLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <DataGrid x:Name="AssetGrid" ItemsSource="{Binding AssetView}" SelectedItem="{Binding SelectedAsset, Mode=TwoWay}" MouseDoubleClick="AssetGrid_OnMouseDoubleClick" AutoGenerateColumns="False" CanUserSortColumns="True" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="56" ColumnHeaderHeight="36" BorderThickness="0" Background="{StaticResource SurfaceBrush}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource SurfaceTintBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="9,0"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource RowSeparatorBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceTintBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="9,0"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Style.Triggers>
                                                <!-- Keep the row's branded selection tint instead of WPF's legacy cell highlight. -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{DynamicResource ColumnAsset}" Width="76" SortMemberPath="AssetNumber" CanUserSort="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="7,0,0,0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding AssetNumber}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AssetNumber}" Value="">
                                                                        <Setter Property="Text" Value="{DynamicResource UnassignedAsset}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningDarkBrush}"/>
                                                                        <Setter Property="FontSize" Value="9"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{DynamicResource ColumnAssetName}" Width="*" SortMemberPath="AssetName" CanUserSort="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AssetName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Site, Mode=OneWay}"/>
                                                            <Run Text="  •  "/>
                                                            <Run Text="{Binding Location, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{DynamicResource ColumnCondition}" Width="132" SortMemberPath="Condition" CanUserSort="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border DataContext="{Binding}" Style="{StaticResource ConditionBadgeBorderStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center" Style="{StaticResource ConditionDotStyle}"/>
                                                            <TextBlock Text="{Binding Condition, Converter={StaticResource LocalizedConditionConverter}}" TextTrimming="None" ToolTip="{Binding Condition, Converter={StaticResource LocalizedConditionConverter}}" Style="{StaticResource ConditionBadgeTextStyle}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Background="{StaticResource SurfaceBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AssetCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                                        <Border Width="42" Height="42" Background="{StaticResource SecondarySoftBrush}" CornerRadius="21" HorizontalAlignment="Center">
                                            <TextBlock Text="+" FontSize="23" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Margin="0,12,0,0" Text="{DynamicResource NoAssetYet}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Margin="0,4,0,0" Text="{DynamicResource NoAssetDescription}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Selected asset -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18,16">
                            <Grid>
                                <Grid Visibility="{Binding HasSelectedAsset, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Padding="7,3" Background="{StaticResource AssetBadgeBrush}" BorderBrush="{StaticResource AssetBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedAssetLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </Border>
                                                <Border Margin="7,0,0,0" DataContext="{Binding SelectedAsset}" Style="{StaticResource ConditionBadgeBorderStyle}" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Style="{StaticResource ConditionDotStyle}"/>
                                                        <TextBlock Text="{Binding Condition, Converter={StaticResource LocalizedConditionConverter}}" Style="{StaticResource ConditionBadgeTextStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,7,0,0" Text="{Binding SelectedAsset.AssetName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,2,0,0" Text="{Binding SelectedAsset.Manufacturer}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding EditAssetCommand}" Content="{DynamicResource Edit}"/>
                                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddMaintenanceCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="+" Margin="0,-1,7,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OnPrimaryBrush}"/>
                                                    <TextBlock Text="{DynamicResource AddMaintenance}" Foreground="{StaticResource OnPrimaryBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Location}"/>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SelectedAsset.Site, Mode=OneWay}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding SelectedAsset.Location, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Model}"/>
                                            <TextBlock Text="{Binding SelectedAsset.Model}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource SerialNumber}"/>
                                            <TextBlock Text="{Binding SelectedAsset.SerialNumber}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="5" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource RecordedPrice}"/>
                                            <TextBlock Text="{Binding SelectedAsset.PurchasePrice, StringFormat={}{0:N2}}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,7" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Visibility="{Binding SelectedAssetHasNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource Notes}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SelectedAssetDisplayNotes}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" ToolTip="{Binding SelectedAssetDisplayNotes}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedAsset}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{DynamicResource SelectMachine}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Margin="0,4,0,0" Text="{DynamicResource SelectedMachineDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Historical timeline -->
                        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Padding="17,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource AssetHistory}" FontSize="14" FontWeight="SemiBold"/>
                                            <Border Margin="8,0,0,0" Padding="7,2" Background="{StaticResource SecondarySoftBrush}" CornerRadius="3">
                                                <TextBlock Text="{Binding HistoryCountLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Margin="0,0,8,0" MinHeight="30" Padding="10,4" FontSize="11" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PrintFullHistoryCommand}" ToolTip="{DynamicResource PrintFullHistoryTooltip}">
                                                <TextBlock Text="{DynamicResource PrintFullHistory}"/>
                                            </Button>
                                            <Border Padding="8,3" Background="{StaticResource SurfaceTintBrush}" CornerRadius="3">
                                                <TextBlock Text="{Binding SelectedYear.DisplayName}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <ListBox ItemsSource="{Binding History}" BorderThickness="0" Background="{StaticResource SurfaceBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="17,14" BorderBrush="{StaticResource RowSeparatorBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DateText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <Border x:Name="HistoryBadge" Margin="0,6,0,0" Padding="6,2" HorizontalAlignment="Left" Background="{StaticResource SecondarySoftBrush}" BorderBrush="{StaticResource SecondaryBorderBrush}" BorderThickness="1" CornerRadius="3">
                                                                <TextBlock x:Name="HistoryBadgeText" Text="{Binding TypeText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                                                            </Border>
                                                            <TextBlock Margin="0,6,0,0" Text="{Binding ReferenceNumber}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="{DynamicResource ReferenceNumberLabel}"/>
                                                        </StackPanel>
                                                        <Grid Grid.Column="1">
                                                            <Border Width="1" Background="{StaticResource TimelineLineBrush}" HorizontalAlignment="Center"/>
                                                            <Ellipse x:Name="HistoryDot" Width="7" Height="7" Fill="{StaticResource SecondaryBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                                    <Button MinHeight="26" Padding="8,3" FontSize="10" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.EditMaintenanceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" ToolTip="{DynamicResource EditMaintenanceTooltip}" Visibility="{Binding IsMaintenance, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource Edit}"/>
                                                                    </Button>
                                                                    <Button Margin="6,0,0,0" MinHeight="26" Padding="8,3" FontSize="10" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.ViewAuditCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" ToolTip="{DynamicResource ViewAuditTooltip}" Visibility="{Binding HasAudit, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{DynamicResource ViewAudit}"/>
                                                                    </Button>
                                                                    <Button Margin="6,0,0,0" MinHeight="26" Padding="8,3" FontSize="10" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.PrintHistoryItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" ToolTip="{DynamicResource PrintHistoryItemTooltip}">
                                                                        <TextBlock Text="{DynamicResource PrintEvent}"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                            <TextBlock Margin="0,4,0,0" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <TextBlock Margin="0,7,0,0" Text="{Binding Meta}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding HasMeta, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            <Border Margin="0,8,0,0" Padding="9,7" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding Notes}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HistoryKind}" Value="Maintenance">
                                                            <Setter TargetName="HistoryBadge" Property="Background" Value="{StaticResource ErrorSoftBrush}"/>
                                                            <Setter TargetName="HistoryBadge" Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}"/>
                                                            <Setter TargetName="HistoryBadgeText" Property="Foreground" Value="{StaticResource ErrorDarkBrush}"/>
                                                            <Setter TargetName="HistoryDot" Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HistoryKind}" Value="InventoryAdded">
                                                            <Setter TargetName="HistoryBadge" Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                            <Setter TargetName="HistoryBadge" Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                                            <Setter TargetName="HistoryBadgeText" Property="Foreground" Value="{StaticResource SuccessDarkBrush}"/>
                                                            <Setter TargetName="HistoryDot" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HistoryKind}" Value="Note">
                                                            <Setter TargetName="HistoryBadge" Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                                                            <Setter TargetName="HistoryBadge" Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                            <Setter TargetName="HistoryBadgeText" Property="Foreground" Value="{StaticResource WarningDarkBrush}"/>
                                                            <Setter TargetName="HistoryDot" Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Background="{StaticResource SurfaceBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasSelectedAsset}" Value="True"/>
                                                            <Condition Binding="{Binding History.Count}" Value="0"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                                            <Border Width="42" Height="42" Background="{StaticResource SecondarySoftBrush}" CornerRadius="21" HorizontalAlignment="Center">
                                                <TextBlock Text="○" FontSize="22" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Margin="0,12,0,0" Text="{DynamicResource NoHistoryInView}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Margin="0,4,0,0" Text="{DynamicResource NoHistoryDescription}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedAsset}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="330">
                                            <TextBlock Text="{DynamicResource SelectMachineToViewHistory}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Margin="0,4,0,0" Text="{DynamicResource UseAssetList}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            </UserControl>
