<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="GeneralMaintenanceManager.App.Views.ReviewView"><Grid>
                <Grid Margin="22,20,22,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ReviewPending}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,0" Text="{DynamicResource ReviewSubtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="820"/>
                                <TextBlock Margin="0,7,0,0" Text="{DynamicResource ReviewExplanation}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Padding="11,6" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReviewCount, StringFormat={}{0:N0}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningDarkBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding ReviewItems}" SelectedItem="{Binding SelectedReviewItem, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Padding="18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Padding="8,4" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningDarkBrush}"/>
                                                    </Border>
                                                    <TextBlock Margin="10,0,0,0" Text="{DynamicResource ReviewReason}" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" MinHeight="30" Command="{Binding DataContext.ReviewLaterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{DynamicResource ReviewLater}"/>
                                            </Grid>

                                            <Border Grid.Row="2" Padding="10,8" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                                <TextBlock Text="{Binding Reasons}" FontSize="10.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            </Border>

                                            <Grid Grid.Row="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Padding="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{DynamicResource RecordA}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <Border HorizontalAlignment="Right" Padding="7,3" Background="{StaticResource AssetBadgeBrush}" BorderBrush="{StaticResource AssetBadgeBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                <TextBlock Text="{Binding AssetADisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Margin="0,9,0,0" Text="{Binding AssetA.AssetName}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <Run Text="{Binding AssetA.Site, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding AssetA.Location, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <Run Text="{Binding AssetA.Manufacturer, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding AssetA.Model, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource SerialNumber}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=": " FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding AssetA.SerialNumber, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource ImportedAssetNumber}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=": " FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding AssetA.ImportedAssetNumber, Mode=OneWay}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                            <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" MinHeight="31" Content="{DynamicResource EditData}" Command="{Binding DataContext.EditReviewACommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            <Button Margin="7,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" MinHeight="31" Content="{DynamicResource AssignAssetNumber}" Command="{Binding DataContext.AssignAssetACommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Padding="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Visibility="{Binding HasSecondRecord, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{DynamicResource RecordB}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <Border HorizontalAlignment="Right" Padding="7,3" Background="{StaticResource AssetBadgeBrush}" BorderBrush="{StaticResource AssetBadgeBorderBrush}" BorderThickness="1" CornerRadius="4">
                                                                <TextBlock Text="{Binding AssetBDisplay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Margin="0,9,0,0" Text="{Binding AssetB.AssetName}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <Run Text="{Binding AssetB.Site, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding AssetB.Location, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <Run Text="{Binding AssetB.Manufacturer, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding AssetB.Model, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource SerialNumber}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=": " FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding AssetB.SerialNumber, Mode=OneWay}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource ImportedAssetNumber}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=": " FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding AssetB.ImportedAssetNumber, Mode=OneWay}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                            <Button Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" MinHeight="31" Content="{DynamicResource EditData}" Command="{Binding DataContext.EditReviewBCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            <Button Margin="7,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" MinHeight="31" Content="{DynamicResource AssignAssetNumber}" Command="{Binding DataContext.AssignAssetBCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasSecondRecord, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" MinHeight="32" Content="{DynamicResource KeepBoth}" Command="{Binding DataContext.KeepBothCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Margin="7,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" MinHeight="32" Content="{DynamicResource MergeIntoA}" Command="{Binding DataContext.MergeIntoACommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <Button Margin="7,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" MinHeight="32" Content="{DynamicResource MergeIntoB}" Command="{Binding DataContext.MergeIntoBCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="{StaticResource AppBackgroundBrush}" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReviewCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                <Border Width="48" Height="48" Background="{StaticResource SuccessSoftBrush}" CornerRadius="24">
                                    <TextBlock Text="✓" FontSize="21" Foreground="{StaticResource SuccessDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Margin="0,12,0,0" Text="{DynamicResource ReviewEmpty}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,5,0,0" Text="{DynamicResource ReviewEmptyDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            </UserControl>
