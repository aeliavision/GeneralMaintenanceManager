<UserControl x:Class="GeneralMaintenanceManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowStyle}" Text="{DynamicResource MaintenanceOverview}"/>
                    <TextBlock Margin="0,2,0,0" Text="{DynamicResource Dashboard}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,3,18,0" Text="{DynamicResource DashboardMaintenanceSubtitle}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddDashboardMaintenanceCommand}" Content="{DynamicResource AddMaintenance}"/>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Text="{DynamicResource MaintenanceThisMonth}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Margin="0,6,0,0" Text="{Binding MaintenanceThisMonthCount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Text="{DynamicResource OpenWorkOrders}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Margin="0,6,0,0" Text="{Binding OpenWorkOrderCount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Text="{DynamicResource PreventiveMaintenanceDue}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Margin="0,6,0,0" Text="{Binding DueMaintenancePlanCount, StringFormat={}{0:N0}}" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="6" Style="{StaticResource KpiCardStyle}"><StackPanel><TextBlock Text="{DynamicResource MaintenanceCostThisMonth}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Margin="0,6,0,0" Text="{Binding MaintenanceCostThisMonth, StringFormat={}{0:N2}}" FontSize="28" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>

            <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{DynamicResource RecentMaintenance}" FontSize="15" FontWeight="SemiBold"/><TextBlock Margin="0,3,0,0" Text="{DynamicResource RecentMaintenanceSubtitle}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource TertiaryButtonStyle}" Command="{Binding ShowMaintenanceReportCommand}" Content="{DynamicResource ViewReport}"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <ItemsControl x:Name="RecentMaintenanceList" ItemsSource="{Binding RecentMaintenanceSummaryItems}">
                            <ItemsControl.ItemTemplate><DataTemplate><Border Padding="0,10" BorderBrush="{StaticResource RowSeparatorBrush}" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DateText}" Style="{StaticResource DataGridSecondarySingleLineTextStyle}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding LocationDisplay, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=34}" Style="{StaticResource DataGridSingleLineTextStyle}" FontWeight="SemiBold" ToolTip="{Binding LocationDisplay}"/><TextBlock Text="{Binding Title, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=34}" Style="{StaticResource DataGridSecondarySingleLineTextStyle}" ToolTip="{Binding Title}"/></StackPanel><Border Grid.Column="2" Style="{StaticResource ActivityBadgeBorderStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding TypeText, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=24}" Style="{StaticResource ActivityBadgeTextStyle}"/></Border><TextBlock Grid.Column="3" Text="{Binding Description, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=95}" Style="{StaticResource DataGridSecondarySingleLineTextStyle}" ToolTip="{Binding Description}"/><TextBlock Grid.Column="4" Text="{Binding ReferenceNumber}" HorizontalAlignment="Right" Style="{StaticResource DataGridSingleLineTextStyle}" Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{StaticResource SurfaceBrush}" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RecentMaintenanceList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"><TextBlock Text="{DynamicResource RecentMaintenanceEmptyTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Margin="0,4,0,0" Text="{DynamicResource RecentMaintenanceEmptyHint}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MostActiveLocations}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,3,0,0" Text="{DynamicResource DashboardTopLocationsHint}" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding DashboardTopLocations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,9" BorderBrush="{StaticResource RowSeparatorBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource DataGridSingleLineTextStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SecondaryText}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ReportActivityTypeBreakdownTitle}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,3,0,0" Text="{DynamicResource DashboardTopTypesHint}" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding DashboardTopMaintenanceTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,9" BorderBrush="{StaticResource RowSeparatorBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource DataGridSingleLineTextStyle}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SecondaryText}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource QuickActions}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" Text="{DynamicResource MaintenanceQuickActionsSubtitle}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <WrapPanel Margin="0,14,0,0" HorizontalAlignment="Right">
                        <Button Margin="0,0,10,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NewWorkOrderCommand}" Content="{DynamicResource NewWorkOrder}" Visibility="{Binding IsWorkOrdersEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Margin="0,0,10,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NewMaintenancePlanCommand}" Content="{DynamicResource NewMaintenancePlan}" Visibility="{Binding IsPreventiveMaintenanceEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Margin="0,0,0,8" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddDashboardMaintenanceCommand}" Content="{DynamicResource AddMaintenance}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
