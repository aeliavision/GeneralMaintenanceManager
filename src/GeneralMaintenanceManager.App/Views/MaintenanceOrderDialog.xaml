<Window x:Class="GeneralMaintenanceManager.App.Views.MaintenanceOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}" Width="700" Height="690" MinWidth="620" MinHeight="590"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=LocationInput}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource EyebrowStyle}" Text="{DynamicResource MaintenanceOrderLabel}"/>
                <TextBlock Margin="0,2,0,0" Text="{Binding DialogTitle}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Margin="0,3,0,0" Text="{DynamicResource MaintenanceOrderCreateSubtitle}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LocationRequired}"/>
                        <ComboBox x:Name="LocationInput" Style="{StaticResource EditableSuggestionComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Locations}" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource SubjectRequired}"/>
                        <ComboBox Style="{StaticResource EditableSuggestionComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Subjects}" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource MaintenanceTypeRequired}"/>
                        <ComboBox Style="{StaticResource EditableSuggestionComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding MaintenanceTypes}" Text="{Binding MaintenanceType, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource PriorityRequired}"/>
                        <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority}" DisplayMemberPath="DisplayName"/>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource ProblemRequestRequired}"/>
                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Height="108" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Problem, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Expander Margin="0,14,0,0" Header="{DynamicResource AdditionalDetailsOptional}">
                    <Border Margin="0,8,0,0" Padding="14" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <StackPanel Visibility="{Binding AssetTrackingEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource AssetOptional}"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}"/>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource SiteOptional}"/>
                            <ComboBox Style="{StaticResource EditableSuggestionComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="False" ItemsSource="{Binding Sites}" Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource RequestedByOptional}"/><TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding RequestedBy, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource AssignedToOptional}"/><TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding AssignedTo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </Grid>
                            <StackPanel Margin="0,12,0,0"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource DueDateOptional}"/><DatePicker Style="{StaticResource FieldDatePickerStyle}" SelectedDate="{Binding DueDate}"/></StackPanel>
                            <StackPanel Margin="0,12,0,0"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource NotesOptional}"/><TextBox Style="{StaticResource FieldTextBoxStyle}" Height="72" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>
                <TextBlock Margin="0,12,0,0" Text="{Binding ValidationMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                <Button Width="100" Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Cancel}" IsCancel="True"/>
                <Button Margin="8,0,0,0" Width="154" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding SaveButtonText}" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
