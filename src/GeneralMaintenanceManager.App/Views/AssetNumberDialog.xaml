<Window x:Class="GeneralMaintenanceManager.App.Views.AssetNumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AssignAssetNumber}"
        Icon="../Assets/Branding/GeneralMaintenanceManagerIcon_multi.ico"
        Width="520"
        Height="485"
        MinWidth="500"
        MinHeight="455"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EyebrowStyle}"
                               Text="{DynamicResource AssetNumberAuditEyebrow}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{DynamicResource AssignAssetNumber}"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{Binding AssetName}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18,24,18">
                <TextBlock Text="{DynamicResource AssetNumberAuditDescription}"
                           FontSize="10.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />

                <Border Margin="0,14,0,0"
                        Style="{StaticResource CardStyle}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="{DynamicResource AssetNumber}" />
                        <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                 Text="{Binding AssetNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,0"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="{DynamicResource ImportedAssetNumber}" />
                        <Border Padding="10,7"
                                Background="{StaticResource SurfaceTintBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBlock Text="{Binding ImportedAssetNumber}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Margin="0,14,0,0"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="{DynamicResource ChangeReason}" />
                        <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                 Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding ValidationMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Width="104"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Cancel}"
                            Click="Cancel_Click"
                            IsCancel="True" />
                    <Button Width="112"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Save}"
                            Click="Save_Click"
                            IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
