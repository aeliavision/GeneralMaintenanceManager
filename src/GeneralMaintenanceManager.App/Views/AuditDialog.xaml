<Window x:Class="GeneralMaintenanceManager.App.Views.AuditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AuditTrail}"
        Icon="../Assets/Branding/GeneralMaintenanceManagerIcon_multi.ico"
        Width="760"
        Height="570"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Padding="7,3" Background="{StaticResource SecondarySoftBrush}" BorderBrush="{StaticResource SecondaryBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <TextBlock Text="{DynamicResource AuditTrail}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}" />
                        </Border>
                        <Border Margin="7,0,0,0" Padding="7,3" Background="{StaticResource AssetBadgeBrush}" BorderBrush="{StaticResource AssetBadgeBorderBrush}" BorderThickness="1" CornerRadius="4">
                            <TextBlock Text="{Binding AssetLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" Text="{Binding RecordTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,1,0,0" Text="{Binding AssetName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Margin="24,18,24,18" ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Style="{StaticResource CardStyle}" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                        <Run Text="{DynamicResource AuditChangedBy}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding ChangedBy, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding ChangedAt}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="{DynamicResource AuditReason}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding Reason, Mode=OneWay}" />
                                </TextBlock>
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Field}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Padding="7,5" Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="3">
                                                    <TextBlock Text="{Binding Before}" FontSize="10" TextWrapping="Wrap" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <Border Grid.Column="3" Padding="7,5" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="3">
                                                    <TextBlock Text="{Binding After}" FontSize="10" TextWrapping="Wrap" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock Text="{DynamicResource AuditImmutableNotice}" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="96" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Close}" IsCancel="True" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
