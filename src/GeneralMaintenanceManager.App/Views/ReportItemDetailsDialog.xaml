<Window x:Class="GeneralMaintenanceManager.App.Views.ReportItemDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ReportItemDetailsTitle}"
        Icon="../Assets/Branding/GeneralMaintenanceManagerIcon_multi.ico"
        Width="780" Height="650" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EyebrowStyle}" Text="{DynamicResource ReportItemDetailsEyebrow}"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="0,2,0,0" Text="{Binding TypeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="10,5" Background="{StaticResource AssetBadgeBrush}" BorderBrush="{StaticResource AssetBadgeBorderBrush}" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReferenceNumber}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">
                <Border Style="{StaticResource CardStyle}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Date}"/><TextBlock Text="{Binding DateText}" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Location}"/><TextBlock Text="{Binding LocationDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource PerformedBy}"/><TextBlock Text="{Binding PerformedBy}" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                </Border>
                <Border Margin="0,10,0,0" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Description}"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Margin="0,10,0,0" Style="{StaticResource CardStyle}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Site}"/><TextBlock Text="{Binding Site}"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Cost}"/><TextBlock Text="{Binding CostText}"/></StackPanel>
                    </Grid>
                </Border>
                <Border Margin="0,10,0,0" Style="{StaticResource CardStyle}" Padding="16" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Notes}"/><TextBlock Text="{Binding Notes}" TextWrapping="Wrap"/></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                <Button Width="110" Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Print}" Click="Print_Click"/>
                <Button Width="100" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Close}" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
