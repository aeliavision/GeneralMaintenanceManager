<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GeneralMaintenanceManager.App.Views.SettingsView">
    <UserControl.Resources>
        <Style x:Key="ModernSettingsTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="SettingsHeaderSurface"
                                    Margin="0,0,0,10"
                                    Padding="5"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource SurfaceTintBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          Background="Transparent"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1"/>
                            </Border>
                            <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSettingsTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="TabHeaderText"
                                       Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="TabHeaderText" Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrintBrandingComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource ModernComboBoxStyle}">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <TabControl Margin="10"
                Background="Transparent"
                BorderThickness="0"
                Style="{StaticResource ModernSettingsTabControlStyle}"
                ItemContainerStyle="{StaticResource ModernSettingsTabItemStyle}">
        <TabItem Header="{DynamicResource GeneralSettingsTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,16,22,24">
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SecondaryBrush}" CornerRadius="7,0,0,7"/>
                            <Grid Grid.Column="1" Margin="18,12,18,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image Width="36" Height="36" VerticalAlignment="Top" Source="Assets/Branding/GeneralMaintenanceManagerIcon.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource AboutApplication}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border Margin="10,0,0,0" Padding="7,2" Background="{StaticResource SecondarySoftBrush}" BorderBrush="{StaticResource SecondaryBorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource ProductionEdition}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Margin="0,3,0,0" Text="{DynamicResource AboutApplicationDescription}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource DevelopedByLabel}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Margin="5,0,0,0" Text="{DynamicResource DeveloperName}" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Column="2" Margin="0,11,16,11" Padding="13,8" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7" VerticalAlignment="Center">
                                <StackPanel MinWidth="102">
                                    <TextBlock Text="{DynamicResource AppVersionLabel}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Margin="0,2,0,0" Text="{Binding ApplicationVersion}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="OptionalFeaturesMaintenanceTypesRow" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="{StaticResource SecondarySoftBrush}" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{DynamicResource OptionalFeatures}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Margin="0,2,0,0" Text="{DynamicResource OptionalFeaturesDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Border Margin="0,12,0,0" Padding="10,7" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource WorkOrdersFeatureTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,12,0" Text="{DynamicResource WorkOrdersFeatureDescription}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsWorkOrdersEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                                </Border>
                                <Border Margin="0,6,0,0" Padding="10,7" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource PreventiveFeatureTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,12,0" Text="{DynamicResource PreventiveFeatureDescription}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsPreventiveMaintenanceEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                                </Border>
                                <Border Margin="0,6,0,0" Padding="10,7" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource AssetTrackingFeatureTitle}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,12,0" Text="{DynamicResource AssetTrackingFeatureDescription}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsAssetTrackingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                                </Border>
                                <Grid Margin="0,8,0,0"><TextBlock Text="{DynamicResource AdvancedModulesHint}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ShowReviewCommand}" Content="{DynamicResource Review}" Visibility="{Binding IsAssetTrackingEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/></Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="{StaticResource SecondarySoftBrush}" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{DynamicResource MaintenanceTypesSettingsTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{DynamicResource MaintenanceTypesSettingsDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                                </Grid>
                                <TextBlock Margin="0,12,0,0" Text="{DynamicResource BuiltInMaintenanceTypesLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBlock Margin="0,3,0,0" Text="{DynamicResource BuiltInMaintenanceTypesSummary}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Margin="0,10,0,0" Text="{DynamicResource CustomMaintenanceTypesLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding NewCustomMaintenanceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource CustomMaintenanceTypeInputHint}"/><Button Grid.Column="2" MinWidth="82" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddCustomMaintenanceTypeCommand}" Content="{DynamicResource AddMaintenanceType}"/></Grid>
                                <ListBox Margin="0,7,0,0" MinHeight="62" MaxHeight="90" ItemsSource="{Binding CustomMaintenanceTypes}" SelectedItem="{Binding SelectedCustomMaintenanceType, Mode=TwoWay}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceTintBrush}"/>
                                <Grid Margin="0,7,0,0"><TextBlock VerticalAlignment="Center" Text="{Binding MaintenanceTypeSettingsMessage, Mode=OneWay}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/><Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoveCustomMaintenanceTypeCommand}" Content="{DynamicResource RemoveSelectedMaintenanceType}"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="GeneralLanguageCard" Margin="0,12,0,0" Style="{StaticResource CardStyle}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" Background="{StaticResource SecondarySoftBrush}" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{DynamicResource LanguageAndLayout}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{DynamicResource LanguageDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Margin="0,5,0,0" Text="{DynamicResource LanguageImmediate}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource LanguageLabel}"/><ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding Languages}" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{DynamicResource DataBackupSettingsTab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DataBackupSettingsRoot" Margin="22,16,22,24">
                    <Grid x:Name="InventoryPortableRow">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18" Visibility="{Binding IsAssetTrackingEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{StaticResource SecondarySoftBrush}" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{DynamicResource InventoryImport}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{DynamicResource InventoryImportDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
                                <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Command="{Binding ImportExcelCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="" Margin="0,0,8,0" FontFamily="{StaticResource IconFontFamily}" FontSize="13" Foreground="{StaticResource OnPrimaryBrush}"/><TextBlock Text="{DynamicResource ImportExcel}" Foreground="{StaticResource OnPrimaryBrush}"/></StackPanel></Button><Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Command="{Binding ExportAssetExcelCommand}" Content="{DynamicResource ExportExcel}"/><Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Command="{Binding ExportAssetCsvCommand}" Content="{DynamicResource ExportCsv}"/></WrapPanel>
                                <TextBlock Text="{DynamicResource AssetExportHint}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border Margin="0,10,0,0" Padding="11,8" Background="{StaticResource SecondarySoftBrush}" BorderBrush="{StaticResource SecondaryBorderBrush}" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel><Grid Margin="0,0,0,6"><TextBlock Text="{Binding ImportProgressText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock HorizontalAlignment="Right" Text="{Binding ImportProgressPercent, Mode=OneWay, StringFormat={}{0}%}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/></Grid><ProgressBar Style="{StaticResource ModernProgressBarStyle}" Minimum="0" Maximum="100" Value="{Binding ImportProgressPercent, Mode=OneWay}"/></StackPanel></Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PortableDataCard" Padding="18">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="Grid.Column" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAssetTrackingEnabled}" Value="False">
                                            <Setter Property="Grid.Column" Value="0"/>
                                            <Setter Property="Grid.ColumnSpan" Value="3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{StaticResource NeutralIconBrush}" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{DynamicResource PortableDataFolder}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{DynamicResource PortableDataDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid>
                                <TextBlock Margin="0,12,0,0" Text="{DynamicResource PortableStorageLocation}" Style="{StaticResource FieldLabelStyle}"/>
                                <Border Padding="10,7" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5"><TextBlock Text="{Binding DataDirectory}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDirectory}"/></Border>
                                <Button Margin="0,9,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenDataFolderCommand}"><StackPanel Orientation="Horizontal"><TextBlock Text="" Margin="0,0,8,0" FontFamily="{StaticResource IconFontFamily}" FontSize="13"/><TextBlock Text="{DynamicResource OpenDataFolder}"/></StackPanel></Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="BackupRestoreRow" Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{StaticResource SuccessSoftBrush}" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{StaticResource SuccessDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{DynamicResource CreateBackup}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{DynamicResource BackupRestoreDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><TextBlock Margin="0,12,0,0" Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource BackupFolder}"/><TextBlock Text="{Binding BackupsDirectory}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupsDirectory}"/><TextBlock Margin="0,3,0,0" Text="{DynamicResource BackupDestinationHint}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><WrapPanel Margin="0,9,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Command="{Binding CreateBackupCommand}" Content="{DynamicResource CreateBackup}"/><Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenBackupFolderCommand}" Content="{DynamicResource OpenBackupFolder}"/></WrapPanel></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{StaticResource WarningSoftBrush}" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{StaticResource WarningDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{DynamicResource RestoreBackup}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{DynamicResource RestoreBackupCardDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid><TextBlock Margin="0,12,0,0" Text="{DynamicResource BackupFolder}" Style="{StaticResource FieldLabelStyle}"/><TextBlock Text="{Binding BackupsDirectory}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackupsDirectory}"/><Button Margin="0,9,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestoreBackupCommand}" Content="{DynamicResource RestoreBackup}"/></StackPanel></Border>
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="11,8" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsBackupOperationRunning, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel><Grid Margin="0,0,0,6"><TextBlock Text="{Binding BackupProgressText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/><TextBlock HorizontalAlignment="Right" Text="{Binding BackupProgressPercent, Mode=OneWay, StringFormat={}{0}%}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessDarkBrush}"/></Grid><ProgressBar Style="{StaticResource ModernProgressBarStyle}" Minimum="0" Maximum="100" Value="{Binding BackupProgressPercent, Mode=OneWay}"/></StackPanel></Border>
                    </Grid>

                    <Border x:Name="DataStorageCard" Margin="0,12,0,0" Style="{StaticResource CardStyle}" Padding="18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="{StaticResource NeutralIconBrush}" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="" FontFamily="{StaticResource IconFontFamily}" FontSize="15" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0,16,0"><TextBlock Text="{DynamicResource DatabaseStructure}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{DynamicResource DatabaseStructureDescription}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="2" Padding="10,6" Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource SQLiteOffline}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessDarkBrush}"/></StackPanel></Border></Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{DynamicResource PrintSettingsTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,22,22,26">
                        <Border Style="{StaticResource CardStyle}" Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="{DynamicResource PrintAutomationTitle}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,4,0,0" Text="{DynamicResource PrintAutomationDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox Content="{DynamicResource AutoPrintWorkOrderActions}" IsChecked="{Binding PrintSettingsEditor.AutoPrintWorkOrderActions, Mode=TwoWay}"/>
                                    <TextBlock Margin="24,5,0,0" Text="{DynamicResource AutoPrintDefaultPrinterHint}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource PrintHeaderFooterTitle}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,4,0,14" Text="{DynamicResource PrintHeaderFooterDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource PrintCustomHeaderLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding PrintSettingsEditor.HeaderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Margin="0,10,0,0" Text="{DynamicResource PrintCustomFooterLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding PrintSettingsEditor.FooterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource PrintCenterBrandingTitle}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,4,0,14" Text="{DynamicResource PrintCenterBrandingDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    <ComboBox Style="{StaticResource PrintBrandingComboBoxStyle}" ItemsSource="{Binding PrintBrandingModes}" SelectedItem="{Binding PrintSettingsEditor.CenterBrandingMode, Mode=TwoWay}"/>
                                    <TextBlock Margin="0,10,0,0" Text="{DynamicResource PrintCenterTextLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}" Text="{Binding PrintSettingsEditor.CenterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Margin="0,10,0,0" Text="{DynamicResource PrintLogoTitle}" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Margin="0,3,0,8" Text="{Binding PrintSettingsEditor.LogoPath}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ChoosePrintLogoCommand}" Content="{DynamicResource ChoosePrintLogo}"/>
                                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemovePrintLogoCommand}" Content="{DynamicResource RemovePrintLogo}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource PrintDocumentLayoutsTitle}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,14" Text="{DynamicResource PrintDocumentLayoutsDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource PrintWorkOrderLayoutTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="{DynamicResource PrintFieldOrderNumber}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowOrderNumber}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldAsset}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowAsset}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldPriority}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowPriority}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldStatus}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowStatus}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldLocation}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowLocation}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldProblem}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowProblem}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldWorkPerformed}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowWorkPerformed}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldPerformedBy}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowPerformedBy}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldCost}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowCost}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldNotes}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowNotes}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldPrintDate}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowPrintDate}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldSignature}" IsChecked="{Binding PrintSettingsEditor.WorkOrder.ShowSignature}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource PrintMaintenanceLayoutTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="{DynamicResource PrintFieldReference}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowReference}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldDate}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowDate}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldType}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowMaintenanceType}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldAsset}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowAsset}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldLocation}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowLocation}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldProblem}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowProblem}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldWorkPerformed}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowWorkPerformed}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldPerformedBy}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowPerformedBy}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldCost}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowCost}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldNotes}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowNotes}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldAuditInformation}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowAuditInformation}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldPrintDate}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowPrintDate}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldSignature}" IsChecked="{Binding PrintSettingsEditor.Maintenance.ShowSignature}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{DynamicResource PrintListReportLayoutTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <CheckBox Content="{DynamicResource PrintFieldReference}" IsChecked="{Binding PrintSettingsEditor.ListReport.ShowReference}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldDate}" IsChecked="{Binding PrintSettingsEditor.ListReport.ShowDate}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldType}" IsChecked="{Binding PrintSettingsEditor.ListReport.ShowType}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldLocation}" IsChecked="{Binding PrintSettingsEditor.ListReport.ShowLocation}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldPerformedBy}" IsChecked="{Binding PrintSettingsEditor.ListReport.ShowPerformedBy}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldCost}" IsChecked="{Binding PrintSettingsEditor.ListReport.ShowCost}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldNotes}" IsChecked="{Binding PrintSettingsEditor.ListReport.ShowNotes}"/>
                                        <CheckBox Content="{DynamicResource PrintFieldPrintDate}" IsChecked="{Binding PrintSettingsEditor.ListReport.ShowPrintDate}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetPrintSettingsCommand}" Content="{DynamicResource ResetPrintSettings}"/>
                                    <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SavePrintSettingsCommand}" Content="{DynamicResource SavePrintSettings}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource DatabaseMaintenanceTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,22,22,26">
                        <Border Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DatabaseStatusTitle}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,14" Text="{DynamicResource DatabaseStatusDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <Border Padding="14" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DatabaseMaintenanceStatusText}" FontWeight="SemiBold"/>
                                        <TextBlock Margin="0,6,0,0" Text="{Binding DatabaseMaintenanceDetails}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshDatabaseStatusCommand}" Content="{DynamicResource RefreshDatabaseStatus}"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource DatabaseMaintenanceActionsTitle}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,14" Text="{DynamicResource DatabaseMaintenanceActionsDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OptimizeDatabaseCommand}" Content="{DynamicResource OptimizeDatabase}"/>
                                    <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AnalyzeDatabaseCommand}" Content="{DynamicResource AnalyzeDatabase}"/>
                                    <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding FullIntegrityCheckCommand}" Content="{DynamicResource FullIntegrityCheck}"/>
                                    <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RebuildWorkOrderSearchCommand}" Content="{DynamicResource RebuildWorkOrderSearch}"/>
                                    <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RebuildActivityHistorySearchCommand}" Content="{DynamicResource RebuildActivityHistorySearch}"/>
                                    <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RebuildReviewDatabaseCommand}" Content="{DynamicResource RebuildReviewDetection}"/>
                                </WrapPanel>
                                <Border Margin="0,12,0,0" Padding="12" Background="{StaticResource SecondarySoftBrush}" BorderBrush="{StaticResource SecondaryBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="{DynamicResource DatabaseMaintenanceWarning}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
    </TabControl>
</UserControl>
