<UserControl x:Class="GeneralMaintenanceManager.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="{DynamicResource UnifiedReportEyebrow}"/>
                        <Border Width="1" Height="14" Margin="12,0" Background="{StaticResource BorderStrongBrush}"/>
                        <TextBlock MaxWidth="760"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource UnifiedReportSubtitle}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource TertiaryButtonStyle}"
                                Command="{Binding LoadMoreGlobalHistoryCommand}"
                                Content="{DynamicResource LoadMore}"
                                Visibility="{Binding HasMoreGlobalHistory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource TertiaryButtonStyle}"
                                Command="{Binding PrintGlobalHistoryCommand}"
                                Content="{DynamicResource PrintReport}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenGlobalHistoryDetailsCommand}"
                                Content="{DynamicResource OpenSelectedDetails}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceTintBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="5">
                    <WrapPanel>
                        <ToggleButton Margin="0,0,5,0"
                                      Style="{StaticResource SegmentedToggleButtonStyle}"
                                      IsChecked="{Binding IsHistoryMaintenanceMode, Mode=OneWay}"
                                      Command="{Binding SetHistoryModeCommand}"
                                      CommandParameter="Maintenance"
                                      Content="{DynamicResource HistoryModeMaintenance}"/>
                        <ToggleButton Margin="0,0,5,0"
                                      Style="{StaticResource SegmentedToggleButtonStyle}"
                                      IsChecked="{Binding IsHistoryWorkOrdersMode, Mode=OneWay}"
                                      Command="{Binding SetHistoryModeCommand}"
                                      CommandParameter="WorkOrders"
                                      Content="{DynamicResource HistoryModeWorkOrders}"/>
                        <ToggleButton Margin="0,0,5,0"
                                      Style="{StaticResource SegmentedToggleButtonStyle}"
                                      IsChecked="{Binding IsHistoryPreventiveMode, Mode=OneWay}"
                                      Command="{Binding SetHistoryModeCommand}"
                                      CommandParameter="PreventiveMaintenance"
                                      Content="{DynamicResource HistoryModePreventive}"/>
                        <ToggleButton Style="{StaticResource SegmentedToggleButtonStyle}"
                                      IsChecked="{Binding IsHistoryAllActivityMode, Mode=OneWay}"
                                      Command="{Binding SetHistoryModeCommand}"
                                      CommandParameter="AllActivity"
                                      Content="{DynamicResource HistoryModeAllActivity}"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Search}"/>
                        <TextBox Height="32" Style="{StaticResource FieldTextBoxStyle}" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Year}"/>
                        <ComboBox Height="32" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource FromDate}"/>
                        <DatePicker Height="32" Style="{StaticResource FieldDatePickerStyle}" SelectedDate="{Binding HistoryFromDate, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource ToDate}"/>
                        <DatePicker Height="32" Style="{StaticResource FieldDatePickerStyle}" SelectedDate="{Binding HistoryToDate, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Site}"/><ComboBox Height="32" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource EditableSuggestionComboBoxStyle}" ItemsSource="{Binding HistorySiteSuggestions}" Text="{Binding HistorySiteFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Location}"/><ComboBox Height="32" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource EditableSuggestionComboBoxStyle}" ItemsSource="{Binding HistoryLocationSuggestions}" Text="{Binding HistoryLocationFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource MaintenanceType}"/><ComboBox Height="32" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource EditableSuggestionComboBoxStyle}" ItemsSource="{Binding HistoryMaintenanceTypeSuggestions}" Text="{Binding HistoryMaintenanceTypeFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource Activity}"/><ComboBox Height="32" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource EditableSuggestionComboBoxStyle}" ItemsSource="{Binding HistoryActivityTypeSuggestions}" Text="{Binding HistoryActivityTypeFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Style="{StaticResource FieldLabelStyle}" Text="{DynamicResource PerformedBy}"/><ComboBox Height="32" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource EditableSuggestionComboBoxStyle}" ItemsSource="{Binding HistoryPerformedBySuggestions}" Text="{Binding HistoryPerformedByFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                </Grid>

                <Border Grid.Row="4"
                        Background="{StaticResource SurfaceTintBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource ReprintMaintenanceRecord}"/>
                        <TextBox Grid.Column="2"
                                 Height="30"
                                 VerticalContentAlignment="Center"
                                 Padding="10,5"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 Text="{Binding MaintenanceReprintNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="4"
                                MinHeight="30"
                                Padding="12,4"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ReprintMaintenanceByNumberCommand}"
                                Content="{DynamicResource ReprintMaintenanceRecord}"/>
                        <TextBlock Grid.Column="6"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource MaintenanceNumberReprintHint}"
                                   TextWrapping="Wrap"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" MinHeight="60" Padding="12,8"><StackPanel><TextBlock Text="{DynamicResource ReportRecords}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{Binding GlobalHistoryCount, StringFormat={}{0:N0}}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" MinHeight="60" Padding="12,8"><StackPanel><TextBlock Text="{DynamicResource Locations}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{Binding UnifiedReportLocationCount, StringFormat={}{0:N0}}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" MinHeight="60" Padding="12,8"><StackPanel><TextBlock Text="{DynamicResource People}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{Binding UnifiedReportPeopleCount, StringFormat={}{0:N0}}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="6" Style="{StaticResource KpiCardStyle}" MinHeight="60" Padding="12,8"><StackPanel><TextBlock Text="{DynamicResource RecordedCost}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock Margin="0,2,0,0" Text="{Binding UnifiedReportCost, StringFormat={}{0:N2}}" FontSize="21" FontWeight="SemiBold"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Padding="16,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource ReportTimelineTitle}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,2,0,0" Text="{DynamicResource ReportTimelineHint}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenGlobalHistoryDetailsCommand}"
                                Content="{DynamicResource OpenSelectedDetails}"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="ReportGrid"
                              MouseDoubleClick="ReportGrid_MouseDoubleClick"
                              ItemsSource="{Binding GlobalHistoryView}"
                              SelectedItem="{Binding SelectedGlobalHistoryItem, Mode=TwoWay}"
                              Style="{StaticResource ModernDataGridStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              IsReadOnly="True"
                              RowHeight="58">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRowStyle}">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Date}" Binding="{Binding DateText}" Width="0.85*" ElementStyle="{StaticResource DataGridSingleLineTextStyle}"/>
                            <DataGridTemplateColumn Header="{DynamicResource Activity}" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource ActivityBadgeBorderStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding TypeText, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=21}" Style="{StaticResource ActivityBadgeTextStyle}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Subject}" Width="3.6*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Title, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=52}" Style="{StaticResource DataGridSingleLineTextStyle}" FontWeight="SemiBold" ToolTip="{Binding Title}"/><Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ReferenceNumber}" Style="{StaticResource DataGridSecondarySingleLineTextStyle}" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Grid.Column="2" Text="{Binding Description, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=86}" Style="{StaticResource DataGridSecondarySingleLineTextStyle}" ToolTip="{Binding Description}"/></Grid></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Location}" Width="1.45*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Site, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=24}" Style="{StaticResource DataGridSingleLineTextStyle}" FontWeight="SemiBold"/><TextBlock Margin="0,2,0,0" Text="{Binding Location, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=28}" Style="{StaticResource DataGridSecondarySingleLineTextStyle}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource By}" Width="1.25*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PerformedBy, Converter={StaticResource SingleLineTextConverter}, ConverterParameter=24}" Style="{StaticResource DataGridSingleLineTextStyle}"/><TextBlock Margin="0,2,0,0" Text="{Binding RecordGroupText}" Style="{StaticResource DataGridSecondarySingleLineTextStyle}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Cost}" Binding="{Binding CostText}" Width="0.75*" ElementStyle="{StaticResource DataGridSingleLineTextStyle}"/>
                            <DataGridTemplateColumn Width="32"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="›" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandAccentBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="{StaticResource SurfaceBrush}" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ReportGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"><TextBlock Text="{DynamicResource ReportsNoDataTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Margin="0,4,0,0" Text="{DynamicResource UnifiedReportEmptyHint}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel></Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
