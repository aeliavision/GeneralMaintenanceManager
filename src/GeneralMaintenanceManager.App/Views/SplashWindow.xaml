<Window x:Class="GeneralMaintenanceManager.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        Width="520"
        Height="310"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="10"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    CornerRadius="17,0,0,17">
                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image Width="112"
                           Height="112"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="/GeneralMaintenanceManager;component/Assets/Branding/GeneralMaintenanceManagerIcon.png" />

                    <TextBlock Grid.Row="1"
                               Margin="0,0,0,4"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource OnPrimaryBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="{DynamicResource BrandSubtitle}" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30,30,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="29"
                           FontWeight="SemiBold"
                           Text="{DynamicResource AppTitle}" />

                <TextBlock Grid.Row="1"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Text="{DynamicResource SplashTagline}" />

                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{DynamicResource SplashStarting}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10.5"
                               Text="{DynamicResource SplashPortableHint}" />
                </StackPanel>

                <Grid Grid.Row="4">
                    <ProgressBar x:Name="StartupProgress"
                                 Height="7"
                                 Maximum="100"
                                 Minimum="0"
                                 Value="4"
                                 Style="{StaticResource ModernProgressBarStyle}" />
                    <TextBlock x:Name="ProgressText"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="10.5"
                               Text="4%" />
                </Grid>

                <TextBlock Grid.Row="5"
                           Margin="0,24,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10"
                           TextAlignment="Right">
                    <Run Text="{DynamicResource DevelopedByLabel}" />
                    <Run Text=" " />
                    <Run Text="{DynamicResource DeveloperName}" />
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</Window>
