<UserControl x:Class="GeneralMaintenanceManager.App.Views.WorkOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="WorkOrderTabButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowStyle}" Text="{DynamicResource MaintenanceOperations}"/>
                <TextBlock Margin="0,2,0,0" Text="{DynamicResource WorkOrders}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Margin="0,3,18,0" Text="{DynamicResource WorkOrdersSubtitle}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewWorkOrderCommand}" Content="{DynamicResource NewWorkOrder}" Visibility="{Binding IsWorkOrdersEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Padding="16,0" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WorkOrderTabButtonStyle}" Tag="{Binding IsWorkOrderListOpen}" Command="{Binding SetWorkOrderListModeCommand}" CommandParameter="Open" Content="{DynamicResource WorkOrderTabOpen}"/>
                        <Button Style="{StaticResource WorkOrderTabButtonStyle}" Tag="{Binding IsWorkOrderListCompleted}" Command="{Binding SetWorkOrderListModeCommand}" CommandParameter="Completed" Content="{DynamicResource WorkOrderTabCompleted}"/>
                        <Button Style="{StaticResource WorkOrderTabButtonStyle}" Tag="{Binding IsWorkOrderListCancelled}" Command="{Binding SetWorkOrderListModeCommand}" CommandParameter="Cancelled" Content="{DynamicResource WorkOrderTabCancelled}"/>
                        <Button Style="{StaticResource WorkOrderTabButtonStyle}" Tag="{Binding IsWorkOrderListAll}" Command="{Binding SetWorkOrderListModeCommand}" CommandParameter="All" Content="{DynamicResource WorkOrderTabAll}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="16,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource WorkOrders}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,2,0,0" Text="{DynamicResource WorkOrdersListHint}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBox Width="220" Text="{Binding WorkOrderSearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                            <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshWorkOrdersCommand}" Content="{DynamicResource Search}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="WorkOrdersGrid" MouseDoubleClick="WorkOrdersGrid_MouseDoubleClick" Style="{StaticResource ModernDataGridStyle}" ItemsSource="{Binding WorkOrders}" SelectedItem="{Binding SelectedWorkOrder, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource WorkOrderNumber}" Width="130" SortMemberPath="WorkOrderNumber"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding WorkOrderNumber}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Location}" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Location}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,2,0,0" Text="{Binding Site}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource Subject}" Width="2.6*" SortMemberPath="Title"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Margin="0,2,0,0" Text="{Binding ProblemDescription}" FontSize="9.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProblemDescription}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="{DynamicResource Priority}" Binding="{Binding Priority, Converter={StaticResource MaintenanceEnumTextConverter}, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="{DynamicResource Status}" Binding="{Binding Status, Converter={StaticResource MaintenanceEnumTextConverter}, Mode=OneWay}" Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource AssignedTo}" Binding="{Binding AssignedTo, Mode=OneWay}" Width="1*"/>
                            <DataGridTextColumn Header="{DynamicResource DueDate}" Binding="{Binding DueDate, Mode=OneWay}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="{StaticResource SurfaceBrush}" IsHitTestVisible="False">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=WorkOrdersGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <TextBlock Text="{DynamicResource NoWorkOrdersTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Margin="0,4,0,0" Text="{DynamicResource NoWorkOrdersHint}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Padding="16,10" Background="{StaticResource SurfaceTintBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PreviousWorkOrderPageCommand}" Content="{DynamicResource PreviousPage}"/>
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding NextWorkOrderPageCommand}" Content="{DynamicResource NextPage}"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PrintWorkOrderCommand}" Content="{DynamicResource PrintWorkOrder}"/>
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AssignWorkOrderCommand}" Content="{DynamicResource AssignWorkOrder}" Visibility="{Binding IsWorkOrdersEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding StartWorkOrderCommand}" Content="{DynamicResource StartWorkOrder}" Visibility="{Binding IsWorkOrdersEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResumeWorkOrderCommand}" Content="{DynamicResource ResumeWorkOrder}" Visibility="{Binding IsWorkOrdersEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding HoldWorkOrderCommand}" Content="{DynamicResource HoldWorkOrder}" Visibility="{Binding IsWorkOrdersEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelWorkOrderCommand}" Content="{DynamicResource CancelWorkOrder}"/>
                            <Button Margin="0,0,0,8" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding CompleteWorkOrderCommand}" Content="{DynamicResource CompleteWorkOrder}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
