<Application x:Class="GeneralMaintenanceManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GeneralMaintenanceManager.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MaintenanceTheme.xaml" />
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FlowDirection x:Key="AppFlowDirection">LeftToRight</FlowDirection>
            <converters:MaintenanceEnumTextConverter x:Key="MaintenanceEnumTextConverter" />
            <converters:SingleLineTextConverter x:Key="SingleLineTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
